<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the terminal redraw at 120 Hz on ProMotion iPhones, in step with scrolling. Merged into the generated Info.plist. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- zurafa://connect?address=NAME.ts.net, from the QR code in the Mac's Settings → Server → Pair. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Zurafa</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zurafa</string>
			</array>
		</dict>
	</array>
	<!-- The "Zurafa agents" Live Activity, started and updated by the Mac through APNs. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
